{
  "name": "@docuvocab/extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "zip": "wxt zip && wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@docuvocab/shared": "workspace:*",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@wxt-dev/module-react": "1.2.2",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7",
    "globals": "^16",
    "jsdom": "^26",
    "typescript": "^5",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.5",
    "vitest": "^5.0.5",
    "wxt": "0.21.4"
  }
}
